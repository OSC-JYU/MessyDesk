{
    "local_url": "http://localhost:9009",
    "id": "md-opencv",
    "adapter": "elg",
    "api": "/api",
    "name": "OpenCV Service",
    "source_url": "https://github.com/MD-opencv",
    "status": "experimental",
    "supported_formats": [],
    "supported_types": [
        "roi.json"
    ],
    "description": "OpenCV Python scripts for image ROI processing.",
    "tasks": {
        "extract": {
            "name": "Extract ROI",
            "source": "source_file",
            "description": "Extract regions of interest from images",
            "info": "Extract ROI",
            "behaviour": "one-to-many"
        },
        "isolate": {
            "name": "Isolate ROI",
            "source": "source_file",
            "description": "Isolate regions of interest in images",
            "info": "Isolate ROI",
            "params": {
                "labels": {
                    "type": "boolean",
                    "description": "Whether to show labels on isolated ROIs",
                    "default": false,
                    "display": "checkbox"
                }
            },
            "behaviour": "one-to-many"
        },
        "fill": {
            "name": "Fill ROI",
            "source": "source_file",
            "description": "Fill regions of interest in images",
            "info": "Fill ROI",
            "params": {
                "color": {
                    "type": "string",
                    "description": "Color to fill the ROI",
                    "default": "ffffff"
                }
            },
            "params_help": {
                "color": {
                    "name": "color",
                    "help": "Define the color to fill the ROI",
                    "display": "textinput"
                }
            },
            "behaviour": "one-to-many"
        },
        "border": {
            "name": "Border ROI",
            "source": "source_file",
            "description": "Add border to regions of interest in images",
            "info": "Border ROI",
            "params": {
                "labels": {
                    "type": "boolean",
                    "description": "Whether to show labels on borders",
                    "default": false
                }
            },
            "params_help": {
                "labels": {
                    "name": "labels",
                    "help": "Show labels on borders",
                    "display": "checkbox"
                }
            },
            "behaviour": "one-to-one"
        },
        "blur": {
            "name": "Blur ROI",
            "source": "source_file",
            "description": "Blur regions of interest in images",
            "info": "Blur ROI",
            "params": {
                "labels": {
                    "type": "boolean",
                    "description": "Whether to show labels on blurred areas",
                    "default": false
                }
            },
            "params_help": {
                "labels": {
                    "name": "labels",
                    "help": "Show labels on blurred areas",
                    "display": "checkbox"
                }
            },
            "behaviour": "one-to-one"
        },
        "binary": {
            "name": "Binary ROI",
            "source": "source_file",
            "description": "Binary threshold regions of interest in images",
            "info": "Binary ROI",
            "behaviour": "one-to-one"
        },
        "binary_invert": {
            "name": "Binary Invert ROI",
            "source": "source_file",
            "description": "Binary invert threshold regions of interest in images",
            "info": "Binary Invert ROI",
            "behaviour": "one-to-one"
        }
    }
}
