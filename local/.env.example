# Copy to .env and change the secrets.

# ArcadeDB root password (the backend logs in with it).
DB_PASSWORD=change-me
# Shared secret between the backend and the consumers. Any long random string, e.g. `openssl rand -hex 32`.
SERVICE_TOKEN=change-me-too

# Port of the UI and API on this machine.
MD_PORT=8200

# development: no login, every request is DEV_USER.
MODE=development
DEV_USER=local.user@localhost

# Languages LibreTranslate loads (each pair is a model download on the first start).
LIBRETRANSLATE_LANGUAGES=en,fi,sv,de
